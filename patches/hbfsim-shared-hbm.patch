+
+hbmsim::SubmitResult ResidencyManager::try_submit_hbm(hbmsim::HbmOp op,
+    std::uint64_t address, std::uint64_t bytes, hbmsim::RequestMetadata metadata,
+    hbmsim::CompletionCallback callback) {
+  if (!bytes || bytes - 1 > std::numeric_limits<std::uint64_t>::max() - address)
+    throw std::invalid_argument("invalid direct HBM range");
+  const auto managed_last = config_.hbm_base + config_.capacity_bytes - 1;
+  const auto request_last = address + bytes - 1;
+  if (address <= managed_last && request_last >= config_.hbm_base)
+    throw std::invalid_argument("direct HBM access overlaps managed residency slots");
+  return bridge_.try_submit_hbm(op, address, bytes, metadata, std::move(callback));
+}
